# Copy this file to .env and fill in real values. .env itself is gitignored.

# ── Database (MySQL/MariaDB) ─────────────────────────────────────────
# Preferred: discrete vars. Values are used verbatim, so a password
# containing special characters (? > ; @ / : #) needs no percent-encoding.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Pool size; optional, defaults to 5.
DB_CONNECTION_LIMIT=5

# Alternative to the discrete DB_* vars above — used only if DB_NAME is unset.
# Special characters in the password must be percent-encoded.
# DATABASE_URL=mysql://user:password@localhost:3306/database

# ── Auth.js (NextAuth) ────────────────────────────────────────────────
# Random secret used to sign session tokens. Generate with:
#   npx auth secret
# or: openssl rand -base64 33
AUTH_SECRET=

# ── Cloudflare R2 (image uploads: blog posts, case studies) ─────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL the bucket is served from (custom domain or r2.dev URL).
# Exposed to the browser — next/image renders uploaded images from it.
NEXT_PUBLIC_R2_PUBLIC_URL=
# Max upload size in bytes, enforced server-side in app/api/upload/route.ts.
# 104857600 = 102400KB (100MB). Optional; defaults to 10485760 (10MB) if unset.
UPLOAD_MAX_SIZE=104857600

# ── Database seed (prisma/seed.ts) ────────────────────────────────────
# Optional — the seed script falls back to admin@virtuosoft.com /
# ChangeMe123! if unset. Change the password after your first sign-in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
