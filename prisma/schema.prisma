generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────── Authors ───────────────────────────

/// A byline shown on a post or case study's author card — independent of
/// the admin login system (User below): an author is a person being
/// credited, not an account that can sign in. One author can be reused
/// across many posts/case studies, and doesn't need to match whichever
/// admin happened to write the content in.
model Author {
  id       String  @id @default(cuid())
  name     String
  jobTitle String?
  bio      String? @db.Text
  image    String?
  linkedIn String?

  posts       BlogPost[]
  caseStudies CaseStudy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────── Blog ───────────────────────────

model BlogCategory {
  id     Int        @id @default(autoincrement())
  label  String
  accent String
  posts  BlogPost[]
}

model BlogPost {
  id         String        @id @default(cuid())
  slug       String        @unique
  title      String
  accent     String
  excerpt    String        @db.Text
  image      String

  /// Shown on post cards in the listings. The form requires it, but the column
  /// stays nullable for rows created before it existed — cards fall back to
  /// image for those.
  thumbnailImage String?

  timeAgo    String
  /// Auto-computed from `content`'s word count at save time (e.g. "8 min
  /// read") — the public article hero and card both display it, so it's
  /// stored rather than recomputed on every render.
  readTime   String        @default("")
  date       String
  content    String        @db.LongText
  href       String
  isFeatured Boolean       @default(false)
  isSidebar  Boolean       @default(false)
  categoryId Int?
  category   BlogCategory? @relation(fields: [categoryId], references: [id])

  authorId String?
  author   Author? @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Industry {
  id          Int         @id @default(autoincrement())
  label       String      @unique
  caseStudies CaseStudy[]
}

model ServiceArea {
  id          Int         @id @default(autoincrement())
  label       String      @unique
  caseStudies CaseStudy[] // implicit many-to-many
}

/// One shared template for every case study detail page: a hero with a
/// laptop mockup + floating stats, a Problem/Solution panel pair, and an
/// Impact before/after table. Every field below the hero basics is optional
/// so a case study can be published incrementally — the public page hides
/// whatever section is still empty rather than printing a bare heading.
model CaseStudy {
  id           String @id @default(cuid())
  slug         String @unique
  heroTitle    String
  heroSubtitle String @db.Text
  heroImage    String

  /// Shown on the case study card in the listing grid. The form requires it,
  /// but the column stays nullable for rows created before it existed — cards
  /// fall back to heroImage for those.
  thumbnailImage String?

  /// Client logo shown on the "More Case Studies" carousel card. Falls back
  /// to no logo (just the background visual) when blank.
  logoImage String?

  /// Optional "View Live Site" link in the hero.
  liveSiteUrl String?

  industryId Int?
  industry   Industry? @relation(fields: [industryId], references: [id])

  serviceAreas ServiceArea[] // implicit many-to-many

  heroTags String @db.Text // one per line — small pill row in the hero
  heroStats CaseStudyHeroStat[]

  // "How Virtuosoft Helped X Scale…" heading + paragraph above the panels.
  summaryHeadingLead   String
  summaryHeadingAccent String
  summaryIntro         String @db.Text

  problemTitleLead   String
  problemTitleAccent String
  problemIntro       String @db.Text
  problemPoints      String @db.Text // one per line

  solutionTitleLead   String
  solutionTitleAccent String
  solutionIntro       String @db.Text
  solutionPoints      String @db.Text // one per line

  impactRows CaseStudyImpactRow[]
  impactNote String @db.Text

  authorId String?
  author   Author? @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A floating stat card in the case-study hero (max 3, per the design).
model CaseStudyHeroStat {
  id    Int    @id @default(autoincrement())
  icon  String // "institutions" | "users" | "funding"
  value String
  label String
  order Int    @default(0)

  caseStudyId String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
}

/// A before/after row in the case-study Impact table.
model CaseStudyImpactRow {
  id     Int    @id @default(autoincrement())
  icon   String // "efficiency" | "latency" | "availability" | "delivery"
  label  String
  before String
  after  String
  order  Int    @default(0)

  caseStudyId String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── Testimonials ───────────────────────────

/// A client quote shown in the "Client Success Stories" carousel on the
/// home page. Rating is a star count (1-5); `order` controls display order
/// (ascending), ties broken by newest first.
model Testimonial {
  id     String @id @default(cuid())
  name   String
  role   String
  quote  String @db.Text
  rating Int    @default(5)
  order  Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// ─────────────────────────── Newsletter ───────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// An enquiry sent from the contact page form.
model ContactMessage {
  id           String  @id @default(cuid())
  name         String
  email        String
  phone        String?
  company      String?
  /// Comma-joined list of the checked interest topics.
  interestedIn String
  description  String  @db.Text

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

// ─────────────────────────── Auth.js ───────────────────────────

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  password String? // bcrypt hash; null for OAuth-only users
  role     Role    @default(USER)

  accounts Account[]
  sessions Session[]
  devices  Device[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A browser that has attempted to sign in, identified by a random id held in
/// a signed httpOnly cookie — not a fingerprint, which breaks on browser
/// updates and is trivial to spoof.
///
/// `approved = false` is the pending state: the credentials were correct but
/// the device is unrecognised, so sign-in was refused and it awaits an admin
/// decision. There is no separate request table; a pending device IS the request.
model Device {
  id       String @id @default(cuid())
  /// Value stored in the client cookie. Unique per user rather than globally,
  /// so two accounts can each trust the same shared browser.
  deviceId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Supplied by the person signing in, so an admin knows what they're approving.
  label     String?
  userAgent String? @db.Text
  ip        String?

  approved   Boolean   @default(false)
  approvedAt DateTime?
  /// Null for the bootstrap device (first sign-in self-approves).
  approvedBy String?

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([userId, approved])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}